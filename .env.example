GEMINI_API_KEY=
# Optional pool: keys from DIFFERENT Google Cloud projects; rotated on HTTP 429 (quota).
# GEMINI_API_KEYS=key_project_1,key_project_2
# Reuse stored answers for identical requests (0 new calls). Set 0 for a fresh live run.
# TIMELENS_RESPONSE_CACHE=1
# TIMELENS_GEMINI_MODEL=gemini-3.5-flash-lite
# TIMELENS_GEMINI_FALLBACKS=gemini-3.5-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.8-flash,gemini-3.1-flash-lite
# TIMELENS_OPENSWARM_MODEL=gemini-3.8-flash
# TIMELENS_PORT=8765
# Optional; the macOS/Windows standard token path is discovered automatically.
# OPENSWARM_TOKEN_PATH=/absolute/path/to/auth.token
OPENSWARM_URL=http://127.0.0.1:8324
